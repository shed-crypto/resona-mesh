# ==============================================================================
# ResonaMesh Node Configuration Template
# Copy this file to .env and adjust variables as needed for your local node.
# NEVER commit .env to version control.
# ==============================================================================

# --- HTTP API & Web Player ---
RESONAMESH_HTTP_ADDR=127.0.0.1:8080
# Allow binding to 0.0.0.0 for containerized/headless servers (default false enforces 127.0.0.1 loopback)
RESONAMESH_ALLOW_INSECURE_HTTP=false
# Run as headless relay node: disables interactive player mutations and serves relay status page (true/false)
RESONAMESH_HEADLESS=false

# --- P2P Network (libp2p) ---
RESONAMESH_P2P_PORT=4001
RESONAMESH_P2P_MDNS=true
# Automatic router port forwarding via UPnP / NAT-PMP (true/false)
RESONAMESH_NAT_PORT_MAP=true
# Optional comma-separated multiaddrs or HTTP(S) JSON seed URLs of bootstrap peers
RESONAMESH_BOOTSTRAP_SEEDS=
# Optional comma-separated STUN resolver servers for WAN port discovery (host:port)
# Defaults to public Google & Cloudflare STUN pool if left empty
RESONAMESH_STUN_SERVERS=stun.l.google.com:19302,stun.cloudflare.com:3478

# --- Governance & Moderation ---
# Optional hex-encoded Ed25519 public key of the trusted Root Admin / Moderator authority
RESONAMESH_TRUSTED_MODERATOR_PUBKEY=
# Optional hex-encoded Ed25519 public key of the trusted release authority for P2P client auto-updates
RESONAMESH_RELEASE_PUBKEY=

# --- Storage & Cache ---
RESONAMESH_DATA_DIR=./data
RESONAMESH_DB_NAME=resonamesh.sqlite
# Maximum audio chunk cache limit in Megabytes (default: 2048 MB = 2 GB)
RESONAMESH_CACHE_MAX_MB=2048

# --- Observability ---
# Supported log levels: debug, info, warn, error
RESONAMESH_LOG_LEVEL=info

# --- Relay Orchestration & Swarm Thresholds ---
# Contribution mode: pex-only (NAT restricted), coordinator (NAT signaling relay), transit (audio proxy relay)
RESONAMESH_RELAY_MODE=coordinator
# Maximum concurrent circuit relay reservation slots (default: 16 for coordinator, 64 for transit)
RESONAMESH_RELAY_MAX_RESERVATIONS=16
# Maximum concurrent relay circuits per peer
RESONAMESH_RELAY_MAX_CIRCUITS=4
# Circuit relay transfer limit in bytes (default: 262144 = 256 KiB for coordinator; 0 for unlimited transit)
RESONAMESH_RELAY_DATA_LIMIT_BYTES=262144
# Circuit relay duration limit in seconds (default: 120s)
RESONAMESH_RELAY_DURATION_SEC=120
# Threshold of connected swarm peers before dynamic bootstrap seeds become dormant (default: 3)
RESONAMESH_MIN_SWARM_PEERS=3
# Maximum active P2P swarm peer connections (default: 32)
RESONAMESH_MAX_SWARM_PEERS=32
